{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NickyCKC/tiktok-techjam-2026-track2/blob/main/configs/experiment-node.schema.json",
  "title": "Track 2 Experiment Node",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "node_id",
    "experiment_id",
    "template",
    "hypothesis",
    "seed",
    "objective"
  ],
  "properties": {
    "schema_version": {"const": 1, "default": 1},
    "node_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "experiment_id": {"type": "string", "minLength": 1},
    "template": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 0},
    "parameters": {"type": "object", "default": {}},
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
      },
      "uniqueItems": true,
      "default": []
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric"],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "direction": {
          "enum": ["maximize", "minimize"],
          "default": "maximize"
        }
      }
    },
    "allow_failure": {"type": "boolean", "default": false}
  }
}
